# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google AdMob App ID (Android / iOS)
GOOGLE_ADMOB_APP_ID="ca-app-pub-9273669553362347~9016886171"
VITE_GOOGLE_ADMOB_APP_ID="ca-app-pub-9273669553362347~9016886171"

# Google AdMob Rewarded Video Ad Unit ID
GOOGLE_ADMOB_REWARDED_AD_UNIT_ID="ca-app-pub-9273669553362347/8698331137"
VITE_GOOGLE_ADMOB_REWARDED_AD_UNIT_ID="ca-app-pub-9273669553362347/8698331137"

# Google AdSense for Games / H5 Games Ads Client ID (Publisher ID)
GOOGLE_H5_CLIENT_ID="ca-pub-9273669553362347"
VITE_GOOGLE_H5_CLIENT_ID="ca-pub-9273669553362347"

